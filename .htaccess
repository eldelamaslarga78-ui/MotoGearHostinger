# ============================================================================
# MotoGear · .htaccess
# ============================================================================

Options -Indexes

RewriteEngine On

# 1. Redirigir URLs .html antiguas a su ruta limpia (301), salvo admin.html
#    (panel de respaldo) y los archivos reales.
RewriteCond %{THE_REQUEST} /([^.]+)\.html [NC]
RewriteCond %{REQUEST_URI} !^/admin\.html$ [NC]
RewriteRule ^ %1 [R=301,L]

# 2. Fallback SPA (History API): toda ruta sin archivo/directorio real se sirve
#    como index.html. No intercepta la API, el backoffice, las imágenes ni el cron.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/(api|backoffice|img|cron)/
RewriteRule ^ index.html [L]

# ============================================================================
# Cabeceras de seguridad
# ============================================================================
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
  # Solo se aplica cuando el navegador está en HTTPS (los navegadores ignoran HSTS por HTTP).
  Header always set Strict-Transport-Security "max-age=31536000"

  # CSP del sitio público. Si añades un servicio externo (analítica, pagos, mapas,
  # imágenes de otro dominio), ábrelo aquí y en ningún otro sitio.
  # images.pexels.com: fotos de sobre.html · google.com: mapa de contacto.
  <FilesMatch "\.html$">
    Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data: https://images.pexels.com; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; script-src 'self'; connect-src 'self'; frame-src https://www.google.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
  </FilesMatch>
</IfModule>

# ============================================================================
# Archivos que no deben servirse nunca
# ============================================================================
<FilesMatch "\.(lock|sql|md|log|ini|dist|ejemplo|example|bak|zip|sh)$">
  Require all denied
</FilesMatch>

<FilesMatch "^config\.local\.php$">
  Require all denied
</FilesMatch>

# ============================================================================
# Caché
# El navegador revalida JS/CSS/HTML: si no cambió responde 304 (rápido) y
# nunca se queda con una versión vieja tras un despliegue.
# ============================================================================
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|html)$">
    Header set Cache-Control "no-cache, must-revalidate"
    # Hostinger añade Expires (+7 días) y su CDN cachea por URL ignorando no-cache.
    # Al unset, el CDN revalida y un despliegue se ve al instante.
    Header always unset Expires
  </FilesMatch>
</IfModule>
